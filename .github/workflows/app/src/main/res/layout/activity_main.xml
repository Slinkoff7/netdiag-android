<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btnScan"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#238636"
        android:text="ПРОВЕРИТЬ СЕТЬ АВТОМАТИЧЕСКИ"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTerminal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#161B22"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="Нажмите кнопку для автоопределения параметров..."
                android:textColor="#3FB950"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#1C2128"
                android:padding="14dp"
                android:text="Здесь появятся рекомендации по улучшению сигнала."
                android:textColor="#E6EDF3"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
